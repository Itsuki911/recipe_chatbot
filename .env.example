DATABASE_URL=postgresql+psycopg2://recipe_user:recipe_password@localhost:5432/recipe_chatbot

# OpenRouter API key. Keep real keys in .env only; .env is ignored by git.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_APP_TITLE=Recipe RAG Chatbot
OPENROUTER_HTTP_REFERER=
OPENROUTER_MAX_TOKENS=1200
OPENROUTER_TIMEOUT_SECONDS=60

# Backend selection.
MAIN_LLM_BACKEND=openrouter
RAG_LLM_BACKEND=openrouter
DEEP_AGENT_LLM_BACKEND=openrouter
STRUCTURED_LLM_BACKEND=openrouter
CRAWL4AI_LLM_PROVIDER=openrouter/google/gemma-4-26b-a4b-it:free
RAG_EMBEDDING_BACKEND=fastembed
RAG_VECTOR_STORE=turbovec

# Free local embedding settings.
HF_MODEL_ID=google/gemma-4-E2B-it
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMS=384
TURBOVEC_BIT_WIDTH=4

# Long-term memory via mem0.
MEM0_ENABLED=true
MEM0_USER_ID=recipe_chatbot_user
WEB_RECIPE_REFERENCE_DIR=data/web_recipe_reference

# Crawl settings for Just One Cookbook.
JOC_START_URL=https://www.justonecookbook.com/
JOC_MAX_PAGES=12
JOC_RECIPE_URLS=https://www.justonecookbook.com/tamagoyaki-japanese-rolled-omelette/,https://www.justonecookbook.com/tonjiru/,https://www.justonecookbook.com/miso-soup/,https://www.justonecookbook.com/dashi/
