DATABASE_URL=postgresql+psycopg2://recipe_user:recipe_password@localhost:5432/recipe_chatbot

# Optional: use OpenAI instead of a local Hugging Face model.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Local Hugging Face fallback settings.
HF_MODEL_ID=google/gemma-4-E2B-it
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Crawl settings for Just One Cookbook.
JOC_START_URL=https://www.justonecookbook.com/
JOC_MAX_PAGES=12
JOC_RECIPE_URLS=https://www.justonecookbook.com/tamagoyaki-japanese-rolled-omelette/,https://www.justonecookbook.com/tonjiru/,https://www.justonecookbook.com/miso-soup/,https://www.justonecookbook.com/dashi/
