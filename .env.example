DATABASE_URL=postgresql+psycopg2://recipe_user:recipe_password@localhost:5432/recipe_chatbot

# Gemini API key. Keep real keys in .env only; .env is ignored by git.
# Gemini remains available by setting *_LLM_BACKEND=gemini.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Qwen via Ollama OpenAI-compatible API.
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_OLLAMA_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen3:4b
QWEN_API_KEY=ollama

# Backend selection.
MAIN_LLM_BACKEND=qwen
RAG_LLM_BACKEND=qwen
DEEP_AGENT_LLM_BACKEND=qwen
STRUCTURED_LLM_BACKEND=qwen
CRAWL4AI_LLM_PROVIDER=ollama/qwen3:4b
RAG_EMBEDDING_BACKEND=fastembed
RAG_VECTOR_STORE=turbovec

# Free local embedding settings.
HF_MODEL_ID=google/gemma-4-E2B-it
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMS=384
TURBOVEC_BIT_WIDTH=4

# Long-term memory via mem0.
MEM0_ENABLED=true
MEM0_USER_ID=recipe_chatbot_user
WEB_RECIPE_REFERENCE_DIR=data/web_recipe_reference

# Crawl settings for Just One Cookbook.
JOC_START_URL=https://www.justonecookbook.com/
JOC_MAX_PAGES=12
JOC_RECIPE_URLS=https://www.justonecookbook.com/tamagoyaki-japanese-rolled-omelette/,https://www.justonecookbook.com/tonjiru/,https://www.justonecookbook.com/miso-soup/,https://www.justonecookbook.com/dashi/
